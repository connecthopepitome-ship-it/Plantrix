rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin'
      );
    }

    // 1. PRODUCTS COLLECTION
    // Public can read only ACTIVE products
    // Direct client writes are forbidden; admins modify via server backend
    match /products/{productId} {
      allow read: if resource.data.status == 'ACTIVE' || isAdmin();
      allow write: if isAdmin();
    }

    // 2. CATEGORIES & TAXONOMY
    match /categories/{categoryId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // 3. COLLECTIONS
    match /collections/{collectionId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // 4. USERS / PATRON PROFILES
    match /users/{userId} {
      allow read, update: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // 5. SAVED ADDRESSES
    match /addresses/{addressId} {
      allow read, write: if isOwner(resource.data.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
    }

    // 6. CUSTOMER CARTS
    match /carts/{cartId} {
      allow read, write: if isOwner(cartId) || isAdmin();
    }

    // 7. ORDERS
    // Customer can read only their own orders
    // Client writes are forbidden to prevent price, discount, or payment status tampering
    // Orders are created strictly through the server checkout endpoint
    match /orders/{orderId} {
      allow read: if isOwner(resource.data.customerUid) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // 8. SHIPMENTS
    // Customers can read tracking if linked to their order; writes admin-only
    match /shipments/{shipmentId} {
      allow read: if isAuthenticated() || isAdmin();
      allow write: if isAdmin();
    }

    // 9. PAYMENTS & WEBHOOK LOGS
    // Strict admin/server-only access
    match /payments/{paymentId} {
      allow read, write: if isAdmin();
    }

    // 10. SITE SETTINGS & CONFIGURATION
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 11. ADMIN USERS & AUDIT TRAIL
    match /adminUsers/{adminId} {
      allow read, write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
