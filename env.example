# Public Firebase web configuration (not a substitute for security rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public site configuration
NEXT_PUBLIC_SITE_URL=https://plantrixbotanics.com
NEXT_PUBLIC_SITE_NAME="Plantrix Botanics"

# R2 image delivery domain (public URL only; never place access secrets here)
NEXT_PUBLIC_PRODUCT_IMAGE_BASE_URL=

# Server-side Firebase Admin credentials: choose ONE supported secure approach.
# Prefer deployment secret bindings or workload identity where supported.
# Do not commit a service-account JSON file.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Cloudflare R2 credentials — server-side only
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Payment provider — configure only after selecting the provider.
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Optional monitoring
ERROR_MONITORING_DSN=
