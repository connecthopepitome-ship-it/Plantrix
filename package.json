{
  "name": "plantrix-botanics",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"try { require('fs').rmSync('.next', { recursive: true, force: true }); require('fs').rmSync('.open-next', { recursive: true, force: true }); } catch (e) {}\"",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "cf-build": "npm run clean && opennextjs-cloudflare && node scripts/patch-opennext-bundle.js",
    "preview": "npm run cf-build && wrangler dev",
    "deploy": "npm run cf-build && wrangler deploy"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "clsx": "^2.1.1",
    "firebase": "^10.14.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^0.3.8",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "wrangler": "^3.114.17"
  }
}
